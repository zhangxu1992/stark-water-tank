# Database
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="change-me-in-production-use-strong-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001

# Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Email Notification (configure later)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
INQUIRY_NOTIFY_EMAIL=

# Client URL (CORS)
CLIENT_URL="http://localhost:3000"
